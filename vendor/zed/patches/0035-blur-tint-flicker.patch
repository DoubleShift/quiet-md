quiet.md: zero the desktop tint layer's opacity instead of only hiding it

The behind-window blur hides NSVisualEffectView's CAChameleonLayer (the
desktop tint) on every updateLayer. On macOS 26+ AppKit unhides it whenever it
resamples the desktop, so the tint came and went and the sidebar under Liquid
Glass flickered. Zero opacity keeps it invisible while AppKit toggles hidden.

diff --git a/crates/gpui_macos/src/window.rs b/crates/gpui_macos/src/window.rs
index 2cff8a6b46ca45764f48e8d62e001a82fc1b205c..a7d766bb2d0ca84eac780fa97d23f7f1189e8f99 100644
--- a/crates/gpui_macos/src/window.rs
+++ b/crates/gpui_macos/src/window.rs
@@ -4088,7 +4088,9 @@ unsafe fn remove_layer_background(layer: *mut AnyObject) {
 
         let class_name: *mut AnyObject = msg_send![layer, className];
         if msg_send![class_name, isEqualToString: ns_string("CAChameleonLayer")] {
-            // Remove the desktop tinting effect.
+            // Remove the desktop tinting effect. quiet.md: zero opacity, not hidden: AppKit
+            // unhides the layer when it resamples the desktop, so hiding it made the tint flicker.
+            let _: () = msg_send![layer, setOpacity: 0f32];
             let _: () = msg_send![layer, setHidden: Bool::YES];
             return;
         }
